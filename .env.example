# Copy to .env and fill in your values. Never commit .env.

# Competition runtime. Take the address and the key from the competition site.
SCENARIO_RUNTIME_ENDPOINT=bluesec.team:443
SCENARIO_RUNTIME_TOKEN=replace-with-your-key
SCENARIO_RUNTIME_VERIFY_TLS=true
# Optional: choose a specific competition arena instead of the currently open default.
# SCENARIO_RUNTIME_ARENA=practice

GRPC_DNS_RESOLVER=native
REMOTE_RUN_LABEL=my-agent
# Shown next to your runs in the competition interface.
AGENT_NAME=my-agent
# Optional: model name shown on the leaderboard instead of LLM_DEFAULT_MODEL.
# PUBLIC_MODEL_NAME=my-model

# OpenAI-compatible LLM provider. All three are required.
LLM_BASE_URL=https://your-llm-endpoint.example/v1
LLM_API_KEY=replace-with-your-key
LLM_DEFAULT_MODEL=Qwen/Qwen3.8-Flash-Next

# Optional sampling. With native tool calling a low temperature keeps runs comparable;
# a mild repetition_penalty guards against loops. vLLM applies it to the whole prompt,
# so values like 1.3 derail long investigations. Thinking is off for structured output.
LLM_TEMPERATURE=0.1
LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}, "repetition_penalty": 1.05}'

# Optional limits.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_COMPLETION_TOKENS=16384
LLM_MAX_STEP_RETRIES=3
# Retry transient provider failures per request, and pause the queue after an outage.
LLM_OUTAGE_WAIT_SECONDS=300
# Keep it under 15 minutes: the platform closes a run after 15 minutes without a request.
LLM_RECOVERY_WAIT_SECONDS=720
BLUESEC_AGENT_MAX_STEPS=100
# After this many calls the agent is told to wrap up and submit.
BLUESEC_AGENT_SOFT_STEPS=25
# Longest tool result kept in the LLM context, and where per-task trajectories go.
BLUESEC_TOOL_RESULT_MAX_CHARS=20000
# History size (chars) that triggers condensing old tool results into a case file.
BLUESEC_CONTEXT_MAX_CHARS=120000
# Re-check the draft report once in thinking mode before submitting (costs LLM time, not score).
BLUESEC_REVIEW_FINISH=true
# Detection knowledge base (Splunk Security Content) offered to the model as a free local tool.
BLUESEC_KNOWLEDGE=true
BLUESEC_KNOWLEDGE_CALLS=8
# Knowledge search ranking: idf | bm25 | hybrid (both fused by reciprocal rank).
BLUESEC_KNOWLEDGE_RANKER=hybrid
# Reasoning on investigation steps: off | key (first step, when stuck, every 10 calls) | all.
BLUESEC_THINKING=key
# Independent chain assessments per task; disagreeing verdicts trigger a tie-break.
BLUESEC_ASSESS_SAMPLES=3
# Independent final reports; artifacts most of them name are kept.
BLUESEC_REPORT_SAMPLES=3
# Offer process_tree and prevalence, built from ordinary runtime calls.
BLUESEC_COMPOSITE_TOOLS=true
# process_tree as well: off, it spent ~3 calls a task and almost never found evidence.
BLUESEC_PROCESS_TREE=false
# Competing hypotheses on a board the code checks; open ones hold the report once.
BLUESEC_HYPOTHESES=true
# Benign reports as a form of roles (what ran, who, what started it, what for), at most
# 4 items built by code.
BLUESEC_REPORT_FORM=true
# What a benign report keeps: core_people (the trigger, the named account it ran as and
# up to two other named accounts opened), core (one other cited account), model (as is).
BLUESEC_BENIGN_SHAPE=core_people
# lean: finish after fewer fruitless calls and past 15 calls; brisk: the same without the
# call budget; normal: slower thresholds.
BLUESEC_PACE=lean
# Directory (AD) lookups per task: they inform the verdict but never count as evidence.
BLUESEC_AD_LOOKUPS=1
# Detection-rule matches on every entity and the knowledge search. Off: in practice they
# fired as often in legitimate cases as in attacks. Playbooks stay on with BLUESEC_KNOWLEDGE.
BLUESEC_DETECTIONS=false
# Before the verdict, count how often each key command occurs in the graph (<=3 searches).
BLUESEC_STACKING=true
# Ask the model whether the case is complete after this many calls, then every 5.
BLUESEC_CHECKPOINT_AFTER=15
# Drop forensic artifacts the accepted attack chain does not support.
BLUESEC_ARTIFACT_FILTER=true
# Pages of process listings opened before the first LLM turn: the trigger's logon session
# first, then the host timeline; 0 disables.
# 1: only the trigger's session (the host timeline page never hit evidence in practice).
BLUESEC_HOST_SWEEP_PAGES=1
# Before the first LLM turn, list logons to the alert host and the account's other hosts.
# Off: in practice runs it cost ~3 calls per task and found no other host.
BLUESEC_LOGON_SWEEP=false
# Before the first LLM turn, open the trigger's account entity (1 call; it is evidence
# in most cases).
BLUESEC_ACCOUNT_CONTEXT=true
# Also open its AD object: it informs a verdict but never counted as evidence in practice.
BLUESEC_ACCOUNT_DIRECTORY=false
# Sweep the part of the window after the trigger's start first, the hour before second.
BLUESEC_SWEEP_SPLIT=false
BLUESEC_TRAJECTORY_DIR=runs
